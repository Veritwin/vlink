# ============================================================================
# VLink Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# Database (Vercel Postgres)
DATABASE_URL="postgres://..."
DIRECT_URL="postgres://..."

# Authentication
SESSION_SECRET="min-32-character-secret-for-jwt-signing"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@vlink.veritwin.com"

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# RPC Providers
ALCHEMY_API_KEY="..."
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=..."

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="..."

# Settlement / Bridge Configuration (LI.FI)
SETTLEMENT_PRIVATE_KEY="your_evm_private_key_for_settlement_wallet"
LIFI_API_URL="https://li.quest/v1"
PYUSD_DEFAULT_CHAIN="42161"
PYUSD_ARBITRUM="0x46850aD61C2B7d64d08c9C754F4525459669698"
PYUSD_ETHEREUM="0x6c3ea9036406852006290770bedfcaba0e23a0e8"
CRON_SECRET="your_cron_secret_here"

# App Configuration
NEXT_PUBLIC_APP_URL="https://v-link.vercel.app"
NODE_ENV="development"
